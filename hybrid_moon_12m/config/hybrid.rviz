Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
  - Class: rviz_default_plugins/Marker
    Name: Hybrid observed map
    Enabled: true
    Topic:
      Value: /hybrid/map_cells
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Color Scheme: map
  - Class: rviz_default_plugins/TF
    Name: Robot frames
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
  - Class: rviz_default_plugins/Pose
    Name: Real LIMO heading
    Enabled: true
    Topic:
      Value: /hybrid/real_pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Shape: Arrow
    Color: 255; 220; 0
    Alpha: 1.0
    Shaft Length: 0.35
    Shaft Radius: 0.045
    Head Length: 0.18
    Head Radius: 0.12
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Map top view
      Target Frame: map
      Angle: 0.0
      Scale: 48.0
      X: 0.0
      Y: 0.0
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1000
  Height: 800
