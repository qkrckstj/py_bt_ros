#VRML_SIM R2025a utf8


# VRML asset references are local to this project.
# Imported CC0 meshes:
# https://polyhaven.com/a/concrete_road_barrier_02
# https://polyhaven.com/a/utility_box_01
# https://polyhaven.com/a/fire_hydrant
# CC0 material sources:
# https://polyhaven.com/a/concrete_debris
# https://polyhaven.com/a/bark_brown_01
# https://polyhaven.com/a/brown_mud
# https://polyhaven.com/a/granular_concrete
# https://polyhaven.com/a/rusty_metal_sheet




# Urban material sources (Poly Haven, CC0):
# https://polyhaven.com/a/asphalt_01
# https://polyhaven.com/a/concrete_pavement
# https://polyhaven.com/a/concrete_brick_wall_001
# https://polyhaven.com/a/red_brick_plaster_patch_02

WorldInfo {
 coordinateSystem "ENU"
  title "Disaster Response - 30 x 30 m Urban Block"
  info [ "Presentation route: physical observation, initial response, urgent reassignment and obstacle bypass." ]
  basicTimeStep 10
}
DEF OVERVIEW Viewpoint {
  description "Compact streets and incident overview"
  position 0 -38 51
  orientation -0.4056637 0.4056637 0.8190689 1.7690713
  fieldOfView 1.07
}
Background { skyColor [ 0.48 0.50 0.53 ] }
DirectionalLight { direction 0.55 0.35 -0.8 intensity 1.22 ambientIntensity 0.36 castShadows TRUE }
DirectionalLight { direction -0.55 -0.6 -0.5 intensity 0.40 ambientIntensity 0.12 }



DEF FLOOR_WEST Solid {
  name "FLOOR_WEST"
  translation -8.95 0 -0.1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.445 0.43
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR_WEST_SHAPE Box { size 12.1 30 0.2 }
    }
  ]
  boundingObject USE FLOOR_WEST_SHAPE
}

DEF FLOOR_EAST Solid {
  name "FLOOR_EAST"
  translation 9.9 0 -0.1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.445 0.43
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR_EAST_SHAPE Box { size 10.2 30 0.2 }
    }
  ]
  boundingObject USE FLOOR_EAST_SHAPE
}

DEF FLOOR_NORTH Solid {
