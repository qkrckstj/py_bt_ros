DEF FLOOR_SOUTH Solid {
  name "FLOOR_SOUTH"
  translation 0.95 -2.5 -0.1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.445 0.43
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR_SOUTH_SHAPE Box { size 7.7 25 0.2 }
    }
  ]
  boundingObject USE FLOOR_SOUTH_SHAPE
}


# Four-way intersection and service alleys within each block.
DEF CITY_SURFACE_REVISED_0 Shape {
  castShadows FALSE
  appearance PBRAppearance { baseColorMap ImageTexture { url [ "@CITY_ROOT@/profiles/junyong_30m/upstream/worlds/textures/city_concrete_pavement_color.jpg" ] } normalMap ImageTexture { url [ "@CITY_ROOT@/profiles/junyong_30m/upstream/worlds/textures/city_concrete_pavement_normal.jpg" ] } normalMapFactor .57 textureTransform TextureTransform { scale 1.00000 1.00000 } roughness 0.86 metalness 0 }
  geometry IndexedFaceSet {
    coord Coordinate { point [ -15 -15 .0018, -11.83 -15 .0018, -11.83 -12.4 .0018, -15 -12.4 .0018 ] }
    texCoord TextureCoordinate { point [ -5.35714 -5.35714, -4.22500 -5.35714, -4.22500 -4.42857, -5.35714 -4.42857 ] }
    coordIndex [ 0 1 2 3 -1 ]
  }
}

