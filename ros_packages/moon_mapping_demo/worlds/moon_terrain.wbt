#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/LimoFourDiff.proto"


WorldInfo {
  info [ "Four LIMO lunar terrain with controlled rotating sunlight" ]
  title "Lunar LIMO - four robots"
  basicTimeStep 10
  gravity 9.81
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "default"
      coulombFriction 1.0
      forceDependentSlip 0.01
      bounce 0
    }
  ]
}
DEF DEMO_VIEW Viewpoint {
  orientation -0.3215361210776252 0.15453824915435682 0.9342015052389181 2.297547866290963
  position 8 -10 10
  description "Crater and hill overview"
}
Background {
  skyColor [ 0 0 0 ]
}
DEF LUNAR_SUN DirectionalLight {
  direction 0.965925826 0 -0.258819045
  color 1 0.98 0.94
  intensity 2
  ambientIntensity 0.015
  castShadows TRUE
}
DEF SUN_MARKER Pose {
  translation 20 20 3
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 1 0.8 emissiveColor 1 1 0.8 }
      geometry Sphere { radius 0.35 subdivision 2 }
      castShadows FALSE
    }
  ]
}
Robot {
  name "lunar_sun_supervisor"
  controller "lunar_sun"
  supervisor TRUE
}









DEF LUNAR_GROUND Solid {
  translation 0 0 -0.05
  name "lunar_ground"
  locked TRUE
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.65 0.65 0.65
        baseColorMap ImageTexture {
          url [ "textures/moon_ground.jpg" ]
        }
        textureTransform TextureTransform { scale 4 4 }
        roughness 1
        metalness 0
      }
      geometry Box { size 20 20 0.1 }
    }
  ]
  boundingObject Box { size 20 20 0.1 }
}

DEF LIMO_1 LimoFourDiff {
  translation -8 -7.6 0.15
  rotation 0 0 1 0
  name "robot1"
  controller "<extern>"
}

DEF LIMO_2 LimoFourDiff {
  translation -8 -6.2 0.15
  rotation 0 0 1 0
  name "robot2"
  controller "<extern>"
}

DEF LIMO_3 LimoFourDiff {
  translation -6.6 -7.6 0.15
  rotation 0 0 1 0
  name "robot3"
  controller "<extern>"
}

DEF LIMO_4 LimoFourDiff {
  translation -6.6 -6.2 0.15
  rotation 0 0 1 0
  name "robot4"
  controller "<extern>"
}





































