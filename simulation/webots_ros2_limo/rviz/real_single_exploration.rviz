Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 110; 110; 110
    Alpha: 0.25
  - Class: rviz_default_plugins/Map
    Name: Shared exploration map
    Enabled: true
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
  - Class: rviz_default_plugins/Odometry
    Name: Real LIMO position
    Enabled: true
    Keep: 1
    Position Tolerance: 0.02
    Angle Tolerance: 0.05
    Covariance:
      Value: false
    Shape:
      Value: Arrow
      Color: 255; 45; 0
      Alpha: 1
      Shaft Length: 0.4
      Shaft Radius: 0.05
      Head Length: 0.2
      Head Radius: 0.12
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 200
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /odom
  - Class: rviz_default_plugins/TF
    Enabled: true
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_link:
        Value: true
    Marker Scale: 0.5
    Name: Robot TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 255; 255
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 0
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Real lidar scan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 100
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Assigned frontier goals
    Enabled: true
    Marker Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /exploration/goals
  - Class: rviz_default_plugins/Path
    Name: Nav2 planned path
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
    Color: 224; 74; 74
    Line Style: Lines
    Line Width: 0.06
    Pose Style: None
    Alpha: 1
  Enabled: true
  Global Options:
    Background Color: 48; 52; 58
    Fixed Frame: map
    Frame Rate: 15
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 100
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1200
  Height: 850
  X: 30
  Y: 50
