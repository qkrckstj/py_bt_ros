Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 110; 110; 110
    Alpha: 0.25
  - Class: rviz_default_plugins/Map
    Name: Shared exploration map
    Enabled: true
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
  - Class: rviz_default_plugins/MarkerArray
    Name: Robots (position markers)
    Enabled: true
    Marker Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /exploration/robots
  - Class: rviz_default_plugins/MarkerArray
    Name: Radio range and multihop links
    Enabled: true
    Marker Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /exploration/radio_markers
  - Class: rviz_default_plugins/MarkerArray
    Name: Assigned frontier goals
    Enabled: true
    Marker Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /exploration/goals
  - Class: rviz_default_plugins/Path
    Name: robot1 planned path
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot1/plan
    Color: 224; 74; 74
    Line Style: Lines
    Line Width: 0.06
    Pose Style: None
    Alpha: 1
  - Class: rviz_default_plugins/Path
    Name: robot2 planned path
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot2/plan
    Color: 62; 176; 111
    Line Style: Lines
    Line Width: 0.06
    Pose Style: None
    Alpha: 1
  - Class: rviz_default_plugins/Path
    Name: robot3 planned path
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot3/plan
    Color: 75; 135; 230
    Line Style: Lines
    Line Width: 0.06
    Pose Style: None
    Alpha: 1
  - Class: rviz_default_plugins/Path
    Name: robot4 planned path
    Enabled: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot4/plan
    Color: 226; 166; 48
    Line Style: Lines
    Line Width: 0.06
    Pose Style: None
    Alpha: 1
  Enabled: true
  Global Options:
    Background Color: 48; 52; 58
    Fixed Frame: map
    Frame Rate: 15
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 24
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1100
  Height: 850
  X: 30
  Y: 50
